# Copia este archivo a .env y rellena lo que uses. Nunca subas .env al repositorio.
# (deploy/install_almalinux.sh lo crea por ti y genera DASHBOARD_ACCESS_KEY.)

# ── Bot (lo leen bot_runner.py y web_server.py) ──
BOT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
BOT_INTERVAL=1h
BOT_DB=data/trading_state.db
# Balance inicial: solo se usa la primera vez que se crea la base
BOT_BALANCE=10000
# Parámetros de Params en JSON, p. ej. {"max_leverage": 2.0}; perfil Trend Rider: {"strategy": "trend"} o deploy/trend_params.json
BOT_PARAMS=
# true en cuentas Spot sin cortos
BOT_NO_SHORT=false
# Orden de fuentes de velas y precios (la primera que responda gana). Vacío = binance_vision,binance,bybit.
# En un VPS de Europa, donde api.binance.com no da 451: MARKET_SOURCES=binance,binance_vision,bybit
MARKET_SOURCES=

# ── Panel web ──
WEB_HOST=127.0.0.1
WEB_PORT=8050
# Mínimo 16 caracteres. Genera una con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_ACCESS_KEY=

# ── Alertas ──
# Webhook de n8n (nodo "Webhook", método POST)
WEBHOOK_URL=
# Telegram: token de @BotFather y el chat que recibe las alertas
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Agentes de IA (ai_agents.py; guía: docs/AGENTES_IA.md) ──
# Todo apagado mientras AI_ENABLED no sea true. La IA solo puede endurecer: pausar entradas (con tu botón), y,
# si se lo gana con pruebas en la escalera, vetar o reducir una entrada o cerrar antes una posición.
# Nunca abre operaciones, sube el tamaño ni mueve stops.
AI_ENABLED=false
# Clave de https://console.anthropic.com (pon también un límite de gasto en la consola). Groq y Gemini son respaldo opcional.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Potencia: economica (~0.90 USD/mes) | equilibrada (~3.70, Opus en las entradas y la auditoría) | maxima (~9.00)
AI_POTENCIA=equilibrada
# Tope de gasto mensual en USD (vacío = 2 / 5 / 12 según la potencia). Al llegar, la IA se calla y el bot sigue igual.
AI_MONTHLY_BUDGET_USD=
# Analista: off | sombra (vota y se anota, nunca gana permisos) | escalera (gana permisos solo con pruebas)
AI_ANALISTA=escalera
# Escalones que puede ganar: 0 ninguno · 1 vetar · 2 vetar y reducir · 3 también cerrar antes una posición
AI_AUTONOMIA_MAX=3
# Bots que vigila la IA: base|parámetros|temporalidad[|solo_resumen], separados por coma. Vacío = Keiner (Trend Rider)
# y Celeste (Tortuga 55) con todos los agentes, y Nathalia (Bot Oficial) solo_resumen: sale en el resumen diario y
# respeta la pausa del vigía, sin analista, salidas ni auditor.
AI_BOT_DBS=
# Laboratorio en sombra (más pares, sin dinero) para juntar pruebas más rápido: params|temporalidad|PARES con espacios.
# Vacío = Trend Rider 4h y Tortuga 55 diario, cada uno con 20 pares (Tortuga también con PAXG).
AI_LAB=true
AI_LAB_PERFILES=
# Guardián de salidas: pregunta como mucho cada AI_SALIDA_HORAS (y cada 3 velas: 72 h en Tortuga) por cada posición
# que ya gana AI_SALIDA_MIN_R
AI_SALIDAS=true
AI_SALIDA_HORAS=24
AI_SALIDA_MIN_R=1
# Vigía de noticias: cada cuántas horas lee los titulares
AI_VIGIA=true
AI_VIGIA_HORAS=4
# true = la pausa se activa sin esperar tu botón (no recomendado al principio)
AI_PAUSA_AUTOMATICA=false
AI_PAUSA_HORAS=24
# Auditor (cada operación cerrada + informe semanal del domingo) y resumen diario (01:00 UTC = 20:00 en Colombia)
AI_AUDITOR=true
AI_RESUMEN=true
AI_RESUMEN_HORA_UTC=1

# ── Tu cuenta de Binance, SOLO LECTURA (pestaña "Mi Binance" del panel) ──
# Llave con solo "Enable Reading", sin trading ni retiros, restringida a la IP del VPS.
# Guía paso a paso: docs/BINANCE_SOLO_LECTURA.md. Los bots siguen en paper: esta llave no opera.
BINANCE_API_KEY=
BINANCE_API_SECRET=
