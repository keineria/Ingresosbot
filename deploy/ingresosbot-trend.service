# systemd: Trend Rider (SKILL_4) en paper trading, EN PARALELO al bot oficial y con su propia base.
# deploy/install_almalinux.sh lo copia pero no lo activa. Para encenderlo:
#   sudo systemctl enable --now ingresosbot-trend
#   journalctl -u ingresosbot-trend -f          # ver el log en vivo
# Comparte el .env (alertas de Telegram, que llegan con el prefijo [Trend Rider]). Pares, base, temporalidad y
# balance salen de su ficha "trend" en deploy/bots.json; los parámetros, de deploy/trend_params.json.
[Unit]
Description=Ingresosbot Trend Rider paper trading 24/7 (perfil paralelo)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ingresosbot
Group=ingresosbot
WorkingDirectory=/opt/Ingresosbot
ExecStart=/opt/Ingresosbot/.venv/bin/python bot_runner.py --env-file .env --bot trend --log-file logs/bot-trend.log
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
