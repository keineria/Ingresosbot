# systemd: bot 24/7 (paper trading). deploy/install_almalinux.sh lo instala y ajusta User y rutas.
# A mano: copia a /etc/systemd/system/, cambia User/rutas y ejecuta
#   sudo systemctl daemon-reload && sudo systemctl enable --now ingresosbot
#   journalctl -u ingresosbot -f        # ver el log en vivo
# Los pares salen de deploy/bots.json (bot "oficial"); temporalidad, balance y parámetros, del .env
# (BOT_INTERVAL, BOT_BALANCE, BOT_PARAMS).
[Unit]
Description=Ingresosbot paper trading 24/7
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ingresosbot
Group=ingresosbot
WorkingDirectory=/opt/Ingresosbot
ExecStart=/opt/Ingresosbot/.venv/bin/python bot_runner.py --env-file .env --bot oficial --log-file logs/bot.log
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
